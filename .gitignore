```gitignore
# macOS
.DS_Store

# VS Code
.vscode/

# Arduino build files
build/
*.elf
*.hex
*.bin
*.map

# Temporary files
*.tmp
*.log

# Arduino IDE cache
arduino_build_*
arduino_cache_*

# PlatformIO (if used later)
.pio/
.pioenvs/
.piolibdeps/

# Secrets
secrets.h
wifi_credentials.h
config.h
```
